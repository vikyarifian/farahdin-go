package components

import (
	"github.com/vikyarifian/farahdin-go/internal/domain"
	"github.com/vikyarifian/farahdin-go/internal/i18n"
	"github.com/vikyarifian/farahdin-go/web"
	"strconv"
)

// Icon renders an Ionicons glyph from the sprite.
templ Icon(name string, class string) {
	<svg class={ "inline-block shrink-0 fill-current", class } aria-hidden="true" focusable="false">
		<use href={ web.Asset("icons/sprite.svg") + "#i-" + name }></use>
	</svg>
}

// Header ports the screen headers: back arrow, centered title.
// backHref is followed without JS; app.js prefers history.back() when possible.
templ Header(title string, backHref string) {
	<header class="sticky top-0 z-10 flex h-14 items-center justify-between border-b border-surface bg-background px-2">
		if backHref != "" {
			<a href={ templ.SafeURL(backHref) } data-back class="flex size-11 items-center justify-center rounded-full text-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-primary">
				@Icon("arrow-back", "size-6")
				<span class="sr-only">{ i18n.T(ctx, "Kembali", "Back") }</span>
			</a>
		} else {
			<span class="size-11"></span>
		}
		<h1 class="font-garamond-sc text-[28px] leading-none text-white">{ title }</h1>
		<span class="size-11"></span>
	</header>
}

// TopicGrid ports the "Choose Topic" tiles of each feature.
templ TopicGrid(topics []domain.Topic, baseHref string, large bool) {
	<p class="p-1 text-center font-garamond text-lg font-bold">{ i18n.T(ctx, "Pilih Topik", "Choose Topic") }</p>
	<ul class="flex flex-wrap justify-center gap-2.5 p-2">
		for _, t := range topics {
			<li>
				<a
					href={ templ.SafeURL(baseHref + "/" + strconv.Itoa(t.Key)) }
					class={ "flex flex-col items-center justify-start gap-2 rounded-2xl border border-muted text-center opacity-95 transition hover:border-primary focus-visible:outline-2 focus-visible:outline-primary",
						templ.KV("size-[150px] pt-6", large), templ.KV("size-[100px] pt-3.5", !large) }
				>
					if large {
						@Icon(t.Icon, "size-[50px] text-primary")
						<span class="text-lg text-white">{ t.Label(i18n.Lang(ctx)) }</span>
					} else {
						@Icon(t.Icon, "size-[34px] text-primary")
						<span class="px-1 text-xs leading-tight text-white">{ t.Label(i18n.Lang(ctx)) }</span>
					}
				</a>
			</li>
		}
	</ul>
}

// FeatureHero is the header illustration and topic title above a form.
templ FeatureHero(image string, title string) {
	<div class="flex flex-col items-center">
		<img src={ web.Asset(image) } alt="" class="h-[120px] w-full object-contain"/>
		<h2 class="px-1 pb-1 font-garamond-sc text-[26px] leading-tight text-white">{ title }</h2>
	</div>
}

// Field is a labelled form control with an optional error message.
templ Field(id string, label string, errMsg string) {
	<div class="mb-2">
		<label for={ id } class="block px-1 pb-0.5 text-base font-bold text-primary">{ label }</label>
		{ children... }
		if errMsg != "" {
			<p id={ id + "-error" } class="mt-1 text-sm text-red-400">{ errMsg }</p>
		}
	</div>
}

// TextInput is the dark outlined input used across forms.
templ TextInput(id string, name string, value string, placeholder string, attrs templ.Attributes) {
	<input
		id={ id }
		name={ name }
		type="text"
		value={ value }
		placeholder={ placeholder }
		class="h-11 w-full rounded-md border border-[#ccc] bg-transparent px-2.5 text-lg text-white placeholder:text-muted read-only:text-muted focus:border-primary focus:outline-none"
		{ attrs... }
	/>
}

// DateInput replaces the native date pickers of the source app.
templ DateInput(id string, name string, value string, max string, attrs templ.Attributes) {
	<input
		id={ id }
		name={ name }
		type="date"
		value={ value }
		min="1900-01-01"
		if max != "" {
			max={ max }
		}
		required
		class="h-11 w-full rounded-md border border-[#ccc] bg-transparent px-2.5 text-lg text-white [color-scheme:dark] focus:border-primary focus:outline-none"
		{ attrs... }
	/>
}

// SubmitButton is the gold primary button with an HTMX loading spinner.
templ SubmitButton(label string) {
	<button type="submit" class="mt-1.5 inline-flex min-h-11 min-w-28 items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 text-lg font-medium text-black transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:opacity-60">
		<span class="htmx-indicator spinner" aria-hidden="true"></span>
		<span>{ label }</span>
	</button>
}

// Alert shows a validation or upstream error inside the result region.
templ Alert(msg string) {
	<div role="alert" class="my-3 rounded-lg border border-red-400/60 bg-red-950/40 p-3 text-sm text-red-200">{ msg }</div>
}

// ResultSheet ports components/Result.tsx: a full-height sheet with a
// "Done" link, a share button (top right), a title and a subtitle.
// closeHref is followed without JS.
templ ResultSheet(title string, subtitle string, closeHref string, share Share) {
	@resultSheet(title, subtitle, closeHref, false, share) {
		{ children... }
	}
}

// ResultSheetReload is a ResultSheet whose "Done" reloads closeHref instead of
// just closing, so the page underneath starts over (Tarot reshuffles the deck).
templ ResultSheetReload(title string, subtitle string, closeHref string, share Share) {
	@resultSheet(title, subtitle, closeHref, true, share) {
		{ children... }
	}
}

templ resultSheet(title string, subtitle string, closeHref string, reload bool, share Share) {
	<section
		class="result-sheet fixed inset-0 z-30 flex flex-col overflow-y-auto bg-background pt-[env(safe-area-inset-top)]"
		role="dialog"
		aria-modal="true"
		aria-labelledby="result-title"
		data-result-sheet
		if reload {
			data-reload-on-close={ closeHref }
		}
	>
		<div class="mx-auto flex w-full max-w-xl flex-1 flex-col px-4 pb-10">
			<div class="mt-4 flex h-12 items-center justify-between">
				<a href={ templ.SafeURL(closeHref) } data-close-sheet class="py-2 pr-4 text-lg text-primary focus-visible:outline-2 focus-visible:outline-primary">
					{ i18n.T(ctx, "Selesai", "Done") }
				</a>
				@ShareSlot(share, false)
			</div>
			<h2 id="result-title" class="font-garamond-sc text-[28px] text-white focus:outline-none">{ title }</h2>
			<p class="pb-2 text-lg text-white">{ subtitle }</p>
			{ children... }
		</div>
	</section>
}

// Lines renders reading paragraphs in the muted result style.
templ Lines(lines []string) {
	for _, l := range lines {
		<p class="mt-2.5 text-justify text-base text-muted">{ l }</p>
	}
}

// Notice is a soft informational note under a result.
templ Notice(msg string) {
	if msg != "" {
		<p class="mt-4 text-sm italic text-muted">{ msg }</p>
	}
}

// Divider is the thin line between list rows.
templ Divider() {
	<hr class="my-3 border-[rgb(129,127,127)]/60"/>
}

