		<path d="M10 20C15.5228 20 20 15.5228 20 10C20 4.47715 15.5228 0 10 0C4.47715 0 0 4.47715 0 10C0 15.5228 4.47715 20 10 20Z" fill="#F0F0F0"></path>
		<path d="M9.56641 10.0003H20.0012C20.0012 9.09773 19.8809 8.22336 19.6567 7.3916H9.56641V10.0003Z" fill="#D80027"></path>
		<path d="M9.56641 4.78254H18.5334C17.9213 3.78363 17.1386 2.9007 16.226 2.17383H9.56641V4.78254Z" fill="#D80027"></path>
		<path d="M9.99828 20.0001C12.3518 20.0001 14.5149 19.1866 16.2231 17.8262H3.77344C5.48164 19.1866 7.6448 20.0001 9.99828 20.0001Z" fill="#D80027"></path>
		<path d="M1.46699 15.2171H18.5315C19.023 14.4152 19.4041 13.5386 19.6548 12.6084H0.34375C0.594414 13.5386 0.975547 14.4152 1.46699 15.2171Z" fill="#D80027"></path>
		<path d="M4.63219 1.56164H5.54348L4.69582 2.17746L5.01961 3.17391L4.17199 2.55809L3.32437 3.17391L3.60406 2.31309C2.85773 2.93477 2.20359 3.66313 1.66453 4.47469H1.95652L1.41695 4.86668C1.33289 5.00691 1.25227 5.14937 1.175 5.29395L1.43266 6.08695L0.951953 5.7377C0.832461 5.99086 0.723164 6.24973 0.624922 6.51398L0.908789 7.38773H1.95652L1.10887 8.00356L1.43266 9L0.585039 8.38418L0.0773047 8.75309C0.0264844 9.1616 0 9.57769 0 10H10C10 4.47719 10 3.82609 10 0C8.02453 0 6.18301 0.573047 4.63219 1.56164ZM5.01961 9L4.17199 8.38418L3.32437 9L3.64816 8.00356L2.80051 7.38773H3.84824L4.17199 6.39129L4.49574 7.38773H5.54348L4.69582 8.00356L5.01961 9ZM4.69582 5.09051L5.01961 6.08695L4.17199 5.47113L3.32437 6.08695L3.64816 5.09051L2.80051 4.47469H3.84824L4.17199 3.47824L4.49574 4.47469H5.54348L4.69582 5.09051ZM8.60656 9L7.75895 8.38418L6.91133 9L7.23512 8.00356L6.38746 7.38773H7.4352L7.75895 6.39129L8.0827 7.38773H9.13043L8.28277 8.00356L8.60656 9ZM8.28277 5.09051L8.60656 6.08695L7.75895 5.47113L6.91133 6.08695L7.23512 5.09051L6.38746 4.47469H7.4352L7.75895 3.47824L8.0827 4.47469H9.13043L8.28277 5.09051ZM8.28277 2.17746L8.60656 3.17391L7.75895 2.55809L6.91133 3.17391L7.23512 2.17746L6.38746 1.56164H7.4352L7.75895 0.565195L8.0827 1.56164H9.13043L8.28277 2.17746Z" fill="#0052B4"></path>
	</svg>
}

templ FlagID() {
	<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
		<path d="M10 20C15.5228 20 20 15.5228 20 10C20 4.47715 15.5228 0 10 0C4.47715 0 0 4.47715 0 10C0 15.5228 4.47715 20 10 20Z" fill="#F0F0F0"></path>
		<path d="M0 10C0 4.47719 4.47719 0 10 0C15.5228 0 20 4.47719 20 10" fill="#A2001D"></path>
	</svg>
}

// LanguageOption is a flag + code, as in the home header dropdown.
templ LanguageOption(lang string) {
	<span class="inline-flex items-center gap-1.5 font-garamond text-white">
		if lang == i18n.ID {
			@FlagID()
		} else {
			@FlagEN()
		}
		{ lang }
	</span>
}

// ShareSlot is the top-right share button of a result sheet and its panel.
// It is empty when there is nothing to share yet (Tarot before "Read Card");
// oob replaces the slot out of band once the reading arrives.
templ ShareSlot(s Share, oob bool) {
	<div
		id="sheet-share"
		if oob {
			hx-swap-oob="true"
		}
		if s.Enabled() {
			data-share
			data-card-heading={ s.Card.Heading }
			data-card-highlight={ s.Card.Highlight }
			data-card-body={ s.Card.Body }
			data-card-images={ ImageList(s.Card.Images) }
			data-card-icons={ ImageList(s.Card.Icons) }
			data-card-love={ strconv.Itoa(s.Card.Love) }
			if s.Card.Chart {
				data-card-chart
			}
			data-card-decor={ s.Card.Decor }
			data-card-cta={ s.Card.CTA }
			data-card-host={ s.Card.Host }
			data-card-bg={ web.Asset("images/hero.png") }
			data-card-heart={ web.Asset("images/icon/love.png") }
			data-card-noheart={ web.Asset("images/icon/unlove.png") }
		}
	>
		if s.Enabled() {
			<button
				type="button"
				popovertarget="share-panel"
				class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-primary px-3.5 text-primary transition hover:bg-primary hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
			>
				@Icon("share-social-outline", "size-5")
				{ i18n.T(ctx, "Bagikan", "Share") }
			</button>
			@sharePanel(s)
		}
	</div>
}

// sharePanel is a popover: it opens without JavaScript (the social links work
// as plain links); share-card.js adds the image, Instagram and TikTok.
templ sharePanel(s Share) {
	<div
		id="share-panel"
		popover
		data-share-panel
		aria-labelledby="share-panel-title"
		class="m-auto max-h-[92dvh] w-[min(92vw,26rem)] overflow-y-auto rounded-xl bg-background p-4 text-white shadow-2xl backdrop:bg-black/70"
	>
		<div class="flex items-center justify-between">
			<h3 id="share-panel-title" class="text-lg font-semibold">{ i18n.T(ctx, "Bagikan hasil", "Share your result") }</h3>
			<button type="button" popovertarget="share-panel" popovertargetaction="hide" class="inline-flex size-10 items-center justify-center rounded-full text-muted hover:text-white focus-visible:outline-2 focus-visible:outline-primary" aria-label={ i18n.T(ctx, "Tutup", "Close") }>
				@Icon("close-outline", "size-6")
			</button>
		</div>
		<div data-share-image-area hidden>
			<div class="mx-auto mt-3 flex aspect-[9/16] w-40 items-center justify-center overflow-hidden rounded-lg bg-black/30">
				<span class="spinner" data-share-loading aria-hidden="true"></span>
				<img data-share-preview hidden alt={ i18n.T(ctx, "Pratinjau gambar hasil", "Preview of the result image") } class="size-full object-contain"/>
			</div>
			<p data-share-error hidden role="alert" class="mt-2 text-center text-sm text-red-300">{ i18n.T(ctx, "Gambar gagal dibuat. Coba lagi.", "Could not create the image. Please try again.") }</p>
			<div class="mt-4 grid grid-cols-2 gap-2">
				@appButton("instagram", "logo-instagram", "Instagram")
				@appButton("tiktok", "logo-tiktok", "TikTok")
			</div>
			<p data-share-hint hidden role="status" class="mt-2 text-center text-sm text-muted">
				{ i18n.T(ctx, "Gambar sudah diunduh. Buka Instagram atau TikTok lalu unggah gambarnya.", "The image was downloaded. Open Instagram or TikTok and upload it.") }
			</p>
		</div>
		<p class="mt-5 text-sm text-muted">{ i18n.T(ctx, "Atau bagikan ke", "Or share to") }</p>
		<div class="mt-2 flex flex-wrap items-center gap-1.5">
			@shareLink(s.WhatsApp(), "logo-whatsapp", "WhatsApp")
			@shareLink(s.Telegram(), "paper-plane-outline", "Telegram")
			@shareLink(s.X(), "logo-x", "X")
			@shareLink(s.Facebook(), "logo-facebook", "Facebook")
			<button
				type="button"
				hidden
				data-share-copy
				data-text={ s.CopyText() }
				data-copied={ i18n.T(ctx, "Tersalin", "Copied") }
				class={ roundButton }
				aria-label={ i18n.T(ctx, "Salin teks", "Copy text") }
			>
				@Icon("copy-outline", "size-5")
			</button>
			<button
				type="button"
				hidden
				data-share-native
				data-title={ s.Title }
				data-text={ s.Text }
				data-url={ s.URL }
				class={ roundButton }
				aria-label={ i18n.T(ctx, "Aplikasi lain", "More apps") }
			>
				@Icon("ellipsis-horizontal", "size-5")
			</button>
			<a data-share-download hidden download="farahdin.jpg" class={ roundButton } aria-label={ i18n.T(ctx, "Unduh gambar", "Download image") }>
				@Icon("download-outline", "size-5")
			</a>
			<span class="sr-only" role="status" aria-live="polite" data-share-status></span>
		</div>
	</div>
}

const roundButton = "inline-flex size-10 items-center justify-center rounded-full border border-muted text-white transition hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-primary"

templ appButton(app string, icon string, label string) {
	<button
		type="button"
		hidden
		data-share-app={ app }
		class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-primary px-3 font-semibold text-black transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
	>
		@Icon(icon, "size-6")
		{ label }
	</button>
}

templ shareLink(href string, icon string, label string) {
	<a
		href={ templ.SafeURL(href) }
		target="_blank"
		rel="noopener noreferrer"
		class={ roundButton }
		aria-label={ i18n.T(ctx, "Bagikan ke ", "Share on ") + label }
	>
		@Icon(icon, "size-5")
	</a>
}
