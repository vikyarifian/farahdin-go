# Copy to .env (never commit .env) and export before running, e.g.
#   set -a; . ./.env; set +a; make run

# development | production
APP_ENV=development
ADDR=:8080
# Public URL. Must be https in production (enables Secure cookies + HSTS).
BASE_URL=http://localhost:8080
# PostgreSQL connection URL (required). Add ?sslmode=require when the server supports TLS.
POSTGRES_URL=postgres://user:password@host:5432/dbname

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials,
# type "Web application"). Authorized redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
SESSION_TTL=720h
APP_TIMEZONE=Asia/Jakarta
UPSTREAM_TIMEOUT=20s

# Development-only email sign-in, refused when APP_ENV=production.
DEV_LOGIN=false

# Tests only: a database where the user may CREATE SCHEMA (never production).
# TEST_POSTGRES_URL=postgres://postgres@127.0.0.1:5432/postgres?sslmode=disable
